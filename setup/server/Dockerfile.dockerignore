# Scoped to setup/server/Dockerfile, so the repo-root .dockerignore is left
# alone -- it excludes /setup/docker/ and the Dockerfiles the tool image builder
# writes to /docker/, which this build has no use for either.
#
# .git is not excluded: the version stage reads the tags from it. It never
# reaches the final image.
.venv/
build/
**/build/
**/__pycache__/
siliconcompiler.egg-info/
/docs/
/tests/
/examples/
/utils/
/setup/docker/
/docker/
